generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Channel {
  FBA
  WFS
  FBM
}

enum OrderStatus {
  AWAITING_PAYMENT
  AWAITING_INBOUND
  RECEIVED
  IN_PREP
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  WALLET
  STRIPE
}

enum TxType {
  TOPUP
  CHARGE
  REFUND
  ADJUSTMENT
}

enum Provider {
  AMAZON
  WALMART
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  company      String?
  phone        String?
  role         Role     @default(CUSTOMER)
  /// Short code printed on every inbound carton, e.g. FX-4821
  customerCode String   @unique
  balanceCents Int      @default(0)
  createdAt    DateTime @default(now())

  orders       Order[]
  transactions WalletTransaction[]
  connections  MarketplaceConnection[]
  products     Product[]
}

model Order {
  id            String         @id @default(cuid())
  ref           String         @unique
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel       Channel
  status        OrderStatus    @default(AWAITING_PAYMENT)
  units         Int
  cartons       Int            @default(0)
  pallets       Int            @default(0)
  fbmOrders     Int            @default(0)
  /// Selected service codes + quantities, see src/lib/pricing.ts
  services      Json
  /// Priced line items snapshot at checkout
  lines         Json
  subtotalCents Int
  taxCents      Int
  totalCents    Int
  paymentMethod PaymentMethod?
  paidAt        DateTime?
  stripeSession String?        @unique
  supplierName  String?
  inboundTracking String?
  outboundTracking String?
  customerNotes String?
  adminNotes    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  items  OrderItem[]
  events OrderEvent[]

  @@index([userId, createdAt])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  title     String
  sku       String?
  asin      String?
  fnsku     String?
  quantity  Int
  receivedQty Int?
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
}

model WalletTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        TxType
  /// Positive = credit, negative = debit
  amountCents Int
  balanceAfterCents Int
  description String
  orderId     String?
  stripeSession String? @unique
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model MarketplaceConnection {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     Provider
  /// Amazon selling_partner_id or Walmart client id
  externalId   String
  storeName    String?
  region       String?
  /// Encrypted with AES-256-GCM (src/lib/crypto.ts)
  secret       String
  lastSyncAt   DateTime?
  lastError    String?
  createdAt    DateTime @default(now())

  products Product[]

  @@unique([userId, provider, externalId])
}

model Product {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId String?
  connection   MarketplaceConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  provider     Provider?
  title        String
  sku          String
  asin         String?
  fnsku        String?
  imageUrl     String?
  /// Units sitting at the marketplace warehouse (from API)
  marketplaceQty Int?
  /// Units in FoxPrep warehouse
  warehouseQty Int      @default(0)
  updatedAt    DateTime @updatedAt

  items OrderItem[]

  @@unique([userId, sku])
}
