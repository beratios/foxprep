generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Channel {
  FBA
  WFS
  FBM
}

enum OrderStatus {
  AWAITING_PAYMENT
  AWAITING_INBOUND
  RECEIVED
  IN_PREP
  AWAITING_LABELS
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  WALLET
  STRIPE
}

enum TxType {
  TOPUP
  CHARGE
  REFUND
  ADJUSTMENT
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum PhotoKind {
  INBOUND
  OUTBOUND
}

enum Provider {
  AMAZON
  WALMART
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  company      String?
  phone        String?
  role         Role     @default(CUSTOMER)
  /// Short code printed on every inbound carton, e.g. FX-4821
  customerCode String   @unique
  balanceCents Int      @default(0)
  termsAcceptedAt DateTime?
  createdAt    DateTime @default(now())

  orders       Order[]
  transactions WalletTransaction[]
  connections  MarketplaceConnection[]
  products     Product[]
  tickets      Ticket[]
}

model Order {
  id            String         @id @default(cuid())
  ref           String         @unique
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel       Channel
  status        OrderStatus    @default(AWAITING_PAYMENT)
  units         Int
  cartons       Int            @default(0)
  pallets       Int            @default(0)
  fbmOrders     Int            @default(0)
  /// Selected service codes + quantities, see src/lib/pricing.ts
  services      Json
  /// Priced line items snapshot at checkout
  lines         Json
  subtotalCents Int
  taxCents      Int
  totalCents    Int
  paymentMethod PaymentMethod?
  paidAt        DateTime?
  stripeSession String?        @unique
  supplierName  String?
  inboundTracking String?
  outboundTracking String?
  customerNotes String?
  adminNotes    String?
  /// Box count, sizes and weights we post so the customer can build the shipment plan
  boxInfo       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  items  OrderItem[]
  events OrderEvent[]
  photos OrderPhoto[]
  documents OrderDocument[]
  tickets Ticket[]

  @@index([userId, createdAt])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  title     String
  sku       String?
  asin      String?
  fnsku     String?
  /// Optional link to the listing or product page
  url       String?
  quantity  Int
  receivedQty Int?
}

/// Support request. OPEN = waiting for FoxPrep, ANSWERED = waiting for the customer.
model Ticket {
  id            String          @id @default(cuid())
  ref           String          @unique
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId       String?
  order         Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subject       String
  status        TicketStatus    @default(OPEN)
  lastMessageAt DateTime        @default(now())
  createdAt     DateTime        @default(now())
  messages      TicketMessage[]

  @@index([status, lastMessageAt])
  @@index([userId, lastMessageAt])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromAdmin Boolean  @default(false)
  author    String
  body      String
  photos    String[]
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model OrderPhoto {
  id        String    @id @default(cuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind      PhotoKind
  url       String
  createdAt DateTime  @default(now())

  @@index([orderId])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
}

model WalletTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        TxType
  /// Positive = credit, negative = debit
  amountCents Int
  balanceAfterCents Int
  description String
  orderId     String?
  stripeSession String? @unique
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model MarketplaceConnection {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     Provider
  /// Amazon selling_partner_id or Walmart client id
  externalId   String
  storeName    String?
  region       String?
  /// Encrypted with AES-256-GCM (src/lib/crypto.ts)
  secret       String
  lastSyncAt   DateTime?
  lastError    String?
  createdAt    DateTime @default(now())

  products Product[]

  @@unique([userId, provider, externalId])
}

model Product {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId String?
  connection   MarketplaceConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  provider     Provider?
  title        String
  sku          String
  asin         String?
  fnsku        String?
  imageUrl     String?
  /// Units sitting at the marketplace warehouse (from API)
  marketplaceQty Int?
  /// Units in FoxPrep warehouse
  warehouseQty Int      @default(0)
  updatedAt    DateTime @updatedAt

  items OrderItem[]

  @@unique([userId, sku])
}

enum DocKind {
  UNIT_LABELS
  BOX_LABELS
  CARRIER_LABELS
  SHIPPING_LABELS
  OTHER
}

/// Label PDFs and other files attached to an order, by the customer or by us
model OrderDocument {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind      DocKind
  name      String
  url       String
  size      Int      @default(0)
  fromAdmin Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([orderId])
}
