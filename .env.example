# --- Database ---
# Local dev: use SQLite by switching prisma/schema.prisma provider to "sqlite" and DATABASE_URL="file:./dev.db"
# Production (Vercel): use a hosted Postgres — Vercel Postgres, Neon, or Supabase all work.
DATABASE_URL="postgresql://user:password@host:5432/foxprep"

# --- Auth ---
# Random 32+ char string, used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# --- Stripe (wallet top-ups) ---
# TODO: fill in once Stripe account is ready. Get these from dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Amazon SP-API (Seller Central integration) ---
# TODO: fill in once registered as an Amazon SP-API developer.
# https://developer-docs.amazon.com/sp-api/docs/registering-your-application
AMAZON_LWA_CLIENT_ID=""
AMAZON_LWA_CLIENT_SECRET=""
AMAZON_APP_ID=""
