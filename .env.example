# Database (Neon Postgres)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
APP_URL="https://foxprepcenter.com"

# Warehouse shown to customers after an order is created
WAREHOUSE_NAME="FoxPrep"
WAREHOUSE_STREET="123 Example St, Unit 4"
WAREHOUSE_CITY="Hamilton"
WAREHOUSE_PROVINCE="ON"
WAREHOUSE_POSTAL="L8E 0A1"
WAREHOUSE_PHONE="+1 (905) 555-0100"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Amazon SP-API (register an app in Seller Central > Develop Apps)
AMAZON_SPAPI_APP_ID="amzn1.sp.solution...."
AMAZON_LWA_CLIENT_ID="amzn1.application-oa2-client...."
AMAZON_LWA_CLIENT_SECRET="..."
# Set to "true" while your app is in draft state
AMAZON_SPAPI_DRAFT="true"

# Admin seed account
ADMIN_EMAIL="admin@foxprepcenter.com"
ADMIN_PASSWORD="change-me"

# WhatsApp number with country code, digits only (e.g. 19055550100). Button is hidden until set.
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Photos (Vercel Blob). Added automatically when the Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=""

# Email (resend.com). Without a key, emails are skipped.
RESEND_API_KEY=""
EMAIL_FROM="FoxPrep <orders@foxprepcenter.com>"
EMAIL_REPLY_TO=""
